# hunk: default child RLIMIT_DATA scales with CP-SAT's worker count (704 + 448 MiB per os.cpu_count()); an explicit OPTIMIZE_CHILD_MEMORY_LIMIT_MB stays exact (bead x2gy)

diff --git a/core/nurse_scheduling/server/config.py b/core/nurse_scheduling/server/config.py
