+// `aria-hidden` does not remove elements from the tab order, so an element hidden this way that
+// stays user-focusable is an interop bug: DOM focus can land where assistive tech sees nothing
+// (axe: aria-hidden-focus). Mirror the `inertOthers` behavior of the `aria-hidden` package this
+// file is ported from: alongside `aria-hidden="true"`, take focusable descendants out of the tab
+// order with `tabindex="-1"` and restore them on cleanup. The `inert` attribute is not usable
+// here because it also blocks pointer interaction, which non-modal popups must keep allowed.
+const focusableSelector = ['a[href]', 'area[href]', 'input:not([disabled])', 'select:not([disabled])', 'textarea:not([disabled])', 'button:not([disabled])', 'iframe', 'audio[controls]', 'video[controls]', '[contenteditable]:not([contenteditable="false"])', '[tabindex]'].join(',');
+const focusRestoreMap = new WeakMap();
+function removeFromTabOrder(node) {
+  const targets = [];
+  if (node.matches?.(focusableSelector)) {
+    targets.push(node);
+  }
+  if (node.querySelectorAll) {
+    targets.push(...node.querySelectorAll(focusableSelector));
+  }
+  const restore = [];
+  targets.forEach(element => {
+    const tabIndex = element.getAttribute('tabindex');
+    if (tabIndex === '-1') {
+      return;
+    }
+    restore.push([element, tabIndex]);
+    element.setAttribute('tabindex', '-1');
+  });
+  return restore;
+}
+function restoreTabOrder(node) {
+  const restore = focusRestoreMap.get(node);
+  if (!restore) {
+    return;
+  }
+  focusRestoreMap.delete(node);
+  restore.forEach(([element, tabIndex]) => {
+    if (element.getAttribute('tabindex') !== '-1') {
+      return;
+    }
+    if (tabIndex === null) {
+      element.removeAttribute('tabindex');
+    } else {
+      element.setAttribute('tabindex', tabIndex);
+    }
+  });
+}
 function getUncontrolledElementsSet(controlAttribute) {
   return uncontrolledElementsSets[controlAttribute];
 }
