
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Python caches (vendored backend — core/)
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Docker local runtime env (copy from docker/.env.example)
docker/.env

# Extracted diagnostic reports (make diagnostic-report); the source of truth is the
# diagnostic-reports named volume, this is only the host-side extraction dir.
/docker/diagnostic-reports/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# superpowers brainstorm scratch — a live server's pid, log, port and token,
# plus throwaway HTML. Local runtime state, never shared.
/.superpowers/
